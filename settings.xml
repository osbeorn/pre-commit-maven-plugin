<settings xmlns="http://maven.apache.org/SETTINGS/1.3.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.3.0 https://maven.apache.org/xsd/settings-1.3.0.xsd">
    <servers>
        <!-- Central Portal user token (generate at central.sonatype.com/account) -->
        <server>
            <id>central</id>
            <username>${env.OSSRH_USERNAME}</username>
            <password>${env.OSSRH_PASSWORD}</password>
            <!-- Maven 3.9+ scopes credentials by host; without this, "central" only matches repo.maven.apache.org -->
            <repositoryOrigins>
                <repositoryOrigin>https://central.sonatype.com</repositoryOrigin>
            </repositoryOrigins>
        </server>
    </servers>
    <profiles>
        <profile>
            <id>central</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <gpg.keyname>447AA35C6FC2D716</gpg.keyname>
                <gpg.passphrase>${env.GPG_PASSPHRASE}</gpg.passphrase>
            </properties>
        </profile>
    </profiles>
    <activeProfiles/>
</settings>
